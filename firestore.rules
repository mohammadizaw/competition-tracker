rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- who is who ----
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function isOwner() { return signedIn() && verified() && email() == 'mohammad.awaad@actvet.gov.ae'; }
    function isCoordinator() {
      return signedIn() && verified()
             && exists(/databases/$(database)/documents/config/roles)
             && email() in get(/databases/$(database)/documents/config/roles).data.coordinators;
    }
    function isAdmin() { return isOwner() || isCoordinator(); }

    // Each teacher's private data: only that teacher.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Each teacher's summary (students entered, statuses, late actions): written by the teacher,
    // readable by the teacher, the owner and the coordinators.
    match /summaries/{userId} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }

    // The list of coordinators: only the owner can change it.
    match /config/roles {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}
