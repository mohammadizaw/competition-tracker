rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email.lower() == 'mohammad.awaad@actvet.gov.ae'; }
    function isCoordinator() {
      return signedIn()
             && exists(/databases/$(database)/documents/config/roles)
             && request.auth.uid in get(/databases/$(database)/documents/config/roles).data.coordinatorUids;
    }
    function isAdmin() { return isOwner() || isCoordinator(); }

    // Each teacher's private data: only that teacher.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    // Each teacher's summary: written by the teacher, readable by the teacher, the owner and coordinators.
    match /summaries/{userId} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }
    // Coordinator list: only the owner can change it.
    match /config/roles {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}
